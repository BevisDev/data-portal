# Container: inject these as env vars (k8s: envFrom a ConfigMap / Secret). The image reads env vars only.
# Local: copy to .env; `npm run dev` reads it from the project root.

# --- Browser (VITE_*): served publicly via /config.js. Never put secrets here. ---
# Root of portal-be; empty = same origin. The app appends /api and /api/notification itself (no trailing slash).
VITE_API_BASE_URL=
VITE_MENU_FROM_BACKEND=false

# --- Server only (nginx proxy / Vite dev proxy): never sent to the browser. ---
# In k8s use the FQDN: http://portal-be.data-portal-be.svc.cluster.local:8080
PORTAL_BE_API_TARGET=http://localhost:8080
PORTAL_BE_API_KEY=
